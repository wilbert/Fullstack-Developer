<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Profile</h1>

  <dl class="mt-6 space-y-2">
    <dt class="font-medium">Name</dt>
    <dd id="profile-full-name"><%= @user.full_name %></dd>

    <dt class="font-medium">Email</dt>
    <dd id="profile-email"><%= @user.email_address %></dd>

    <dt class="font-medium">Role</dt>
    <dd id="profile-role"><%= @user.role %></dd>
  </dl>

  <%= button_to "Sign out", session_path, method: :delete, class: "mt-6 underline" %>
</div>
