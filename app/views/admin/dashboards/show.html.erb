<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Admin dashboard</h1>

  <p class="mt-2" id="user-count"><%= pluralize(@users.count, "user") %></p>

  <ul class="mt-6 space-y-1">
    <% @users.each do |user| %>
      <li><%= user.full_name %> &mdash; <%= user.role %></li>
    <% end %>
  </ul>

  <%= button_to "Sign out", session_path, method: :delete, class: "mt-6 underline" %>
</div>
